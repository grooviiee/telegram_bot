# simple_fast_api 환경변수 예시 — 실제 값으로 채운 뒤 .env 로 복사하세요.
# 주의: .env 에는 비밀키가 들어갑니다. 절대 커밋하지 마세요.

# --- 필수 ---
DART_API_KEY=           # DART OpenAPI 인증키 (https://opendart.fss.or.kr)
GEMINI_API_KEY=         # Google Gemini API 키

# --- 선택 (없으면 봇 비활성화, API만 동작) ---
TELEGRAM_BOT_TOKEN=     # @BotFather 에서 발급
WEBHOOK_SECRET_TOKEN=   # /webhook 시크릿 토큰 검증용
API_BASE_URL=http://localhost:8000   # 봇 → 내부 API 호출 주소
